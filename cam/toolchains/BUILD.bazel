load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@freecad_toolchains//:posts.bzl", "POSTS")
load("//cam/private:extensions.bzl", "DEFAULT_FREECAD_VERSION")
load("//cam/private:freecad_toolchain.bzl", "freecad_stub_toolchain")
load("//cam/private:gcode_check.bzl", "gcode_check_toolchain")
load("//cam/private:toolchains.bzl", "helpers_toolchain", "unsupported_platform_toolchain")

# --@hdlf_rules_cam//cam/toolchains:use_stub swaps every tool for the stub.
# swap_test sets it with a transition. A tool toolchain honors it by
# carrying target_settings = [":stub_off"], and its stub twin
# target_settings = [":stub_on"].
bool_flag(
    name = "use_stub",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "stub_on",
    flag_values = {":use_stub": "true"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "stub_off",
    flag_values = {":use_stub": "false"},
    visibility = ["//visibility:public"],
)

helpers_toolchain(
    name = "helpers_impl",
    compare = "//cam/private/detcompare",
    launcher = "//cam/private/launcher",
    swapcheck = "//cam/private/swapcheck",
    toolcheck = "//cam/private/toolcheck:cmd",
)

# The helpers run on Linux x86_64 only in v1 (spec P1). The outputs of the
# rules are files for any platform, so the target platform is not
# constrained here; issue #6 adds the analysis-time check for other hosts.
toolchain(
    name = "helpers",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":helpers_impl",
    toolchain_type = "//cam:helpers_toolchain_type",
)

# Any other execution platform: Bazel tries toolchains in the order they
# are registered, and MODULE.bazel registers this one last, so it is
# picked only where the one above does not match. Its analysis fails with
# a message that says which platform is supported (spec P1).
unsupported_platform_toolchain(
    name = "unsupported_impl",
    tags = ["manual"],
    visibility = ["//tests:__subpackages__"],
)

toolchain(
    name = "unsupported",
    toolchain = ":unsupported_impl",
    toolchain_type = "//cam:helpers_toolchain_type",
)

# swap_test's stand-in for freecadcmd. It offers the prebuilt tree's
# post-processors, so a target that analyzes there analyzes here.
freecad_stub_toolchain(
    name = "freecad_stub_impl",
    posts = POSTS,
    stub = "//cam/private/stub",
    version = DEFAULT_FREECAD_VERSION,
)

toolchain(
    name = "freecad_stub",
    target_settings = [":stub_on"],
    toolchain = ":freecad_stub_impl",
    toolchain_type = "//cam:toolchain_type",
)

# gcode_check_test's checker, built from source (issue #10).
gcode_check_toolchain(
    name = "gcode_check_impl",
    checker = "//cam/private/gcodecheck:cmd",
)

toolchain(
    name = "gcode_check",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":gcode_check_impl",
    toolchain_type = "//cam:gcode_check_toolchain_type",
)
