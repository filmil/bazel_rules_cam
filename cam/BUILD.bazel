# SPDX-License-Identifier: Apache-2.0
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//cam/private"],
)

# The toolchain type of this module's own Go helpers: the launcher that
# every action runs through, and the stub and checker of swap_test.
toolchain_type(
    name = "helpers_toolchain_type",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//cam/private"],
)

# The toolchain type of FreeCAD (freecadcmd and its tree), which every rule
# that runs FreeCAD needs.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

# The toolchain type of gcode_check_test's checker.
toolchain_type(
    name = "gcode_check_toolchain_type",
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "defs.bzl",
        "extensions.bzl",
    ],
    visibility = ["//docs:__pkg__"],
)
