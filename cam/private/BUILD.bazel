load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load(":numbers_test.bzl", "numbers_test")

bzl_library(
    name = "private",
    srcs = [
        "cam_job.bzl",
        "determinism.bzl",
        "extensions.bzl",
        "freecad_toolchain.bzl",
        "gcode_check.bzl",
        "gcode_render.bzl",
        "machine.bzl",
        "numbers.bzl",
        "run_tool.bzl",
        "swap_test.bzl",
        "tool_library.bzl",
        "toolchains.bzl",
    ],
    visibility = ["//cam:__subpackages__"],
)

# A setting that changes nothing but the configuration. determinism_test
# builds its target once with "a" and once with "b", so every action runs
# twice, with different output paths.
string_flag(
    name = "determinism_salt",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

# parse_number, which machine uses to check the numbers it takes as
# strings: what it reads, and what it refuses.
numbers_test(
    name = "numbers_test",
    size = "small",
)

# tools/freecad_prebuilt checks that the sha256 it makes is the one pinned here.
exports_files(
    ["extensions.bzl"],
    visibility = ["//tools/freecad_prebuilt:__pkg__"],
)
