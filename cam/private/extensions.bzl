# SPDX-License-Identifier: Apache-2.0
"""The `freecad` module extension: the prebuilt FreeCAD toolchain (spec H2, H4)."""

# The prebuilt FreeCAD trees, by the version freecadcmd reports. Each is the
# official AppImage of that version, unpacked without running it, pruned to
# freecadcmd and the CAM workbench, and packed as a reproducible tarball by
# make-freecad-prebuilt.sh. The release notes of each asset name the
# AppImage it came from and its sha256. Only this repository's release
# hosts the tarball, so it has one URL.
_FREECAD = {
    "1.1.4": struct(
        urls = ["https://github.com/filmil/bazel_rules_cam/releases/download/prebuilt-freecad-1.1.4/freecad-1.1.4-linux-x86_64.tar.xz"],
        sha256 = "85d7d93c84f6d08e799e1a890860c86ae5b2f4d527afed509aca196a50d33ba3",
        strip_prefix = "freecad-1.1.4-linux-x86_64",
    ),
}

DEFAULT_FREECAD_VERSION = "1.1.4"

# Where the post-processors live in the tree, relative to it.
_POSTS_DIR = "freecad/usr/Mod/CAM/Path/Post/scripts"

_BUILD = """# Generated by the freecad module extension of hdlf_rules_cam.
load("@hdlf_rules_cam//cam/private:freecad_toolchain.bzl", "freecad_toolchain")

freecad_toolchain(
    name = "freecad_impl",
    data = glob(["freecad/**"], allow_empty = False),
    freecadcmd = "freecad/usr/bin/freecadcmd",
    posts = {posts},
    version = "{version}",
)

toolchain(
    name = "freecad",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = ["@hdlf_rules_cam//cam/toolchains:stub_off"],
    toolchain = ":freecad_impl",
    toolchain_type = "@hdlf_rules_cam//cam:toolchain_type",
)
"""

def _freecad_toolchains_repo_impl(rctx):
    f = _FREECAD[rctx.attr.version]
    rctx.download_and_extract(
        url = f.urls,
        sha256 = f.sha256,
        stripPrefix = f.strip_prefix,
        output = "freecad",
    )
    posts = sorted([
        p.basename[:-len("_post.py")]
        for p in rctx.path(_POSTS_DIR).readdir()
        if p.basename.endswith("_post.py")
    ])
    if not posts:
        fail("the FreeCAD %s tree has no post-processors in %s" % (rctx.attr.version, _POSTS_DIR))
    rctx.file("BUILD.bazel", _BUILD.format(version = rctx.attr.version, posts = repr(posts)))

    # For the stub toolchain, which must offer the same posts.
    rctx.file("posts.bzl", "# Generated by the freecad module extension of hdlf_rules_cam.\nPOSTS = %r\n" % posts)

_freecad_toolchains_repo = repository_rule(
    implementation = _freecad_toolchains_repo_impl,
    attrs = {"version": attr.string(mandatory = True)},
)

def _freecad_impl(mctx):
    version = DEFAULT_FREECAD_VERSION
    for mod in mctx.modules:
        if mod.is_root and mod.tags.toolchain:
            if len(mod.tags.toolchain) > 1:
                fail("freecad.toolchain: the root module has %d tags; give one" % len(mod.tags.toolchain))
            version = mod.tags.toolchain[0].version
    if version not in _FREECAD:
        fail("hdlf_rules_cam has no prebuilt FreeCAD %s; it has %s" % (version, sorted(_FREECAD.keys())))
    _freecad_toolchains_repo(name = "freecad_toolchains", version = version)
    return mctx.extension_metadata(reproducible = True)

freecad = module_extension(
    implementation = _freecad_impl,
    doc = """The prebuilt FreeCAD toolchain.

hdlf_rules_cam registers it, so a user needs nothing to get FreeCAD
""" + DEFAULT_FREECAD_VERSION + """. The tree is the official AppImage, unpacked and
pruned to `freecadcmd` and the CAM workbench (about 700 MB); it runs with no
display and no host libraries but glibc.

The root module can pick another version that hdlf_rules_cam has a
prebuilt for:

```starlark
freecad = use_extension("@hdlf_rules_cam//cam:extensions.bzl", "freecad")
freecad.toolchain(version = "1.1.4")
```
""",
    tag_classes = {
        "toolchain": tag_class(
            doc = "Picks the FreeCAD version. Only the root module's tag counts.",
            attrs = {"version": attr.string(
                doc = "A FreeCAD version that hdlf_rules_cam has a prebuilt for.",
                default = DEFAULT_FREECAD_VERSION,
            )},
        ),
    },
)
