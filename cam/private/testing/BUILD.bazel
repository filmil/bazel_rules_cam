load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_go//go:def.bzl", "go_test")
load("//cam:defs.bzl", "cam_job", "determinism_test", "gcode_check_test", "gcode_render", "machine", "swap_test", "tool_library")
load(":testing.bzl", "cam_job_failure_test", "fails_test", "freecad_step")

bzl_library(
    name = "testing",
    srcs = ["testing.bzl"],
    visibility = ["//tests:__subpackages__"],
    deps = ["//cam/private"],
)
# cam_job (issue #9), end to end: a STEP part, made by FreeCAD; a tool
# library; two machines with different posts. The G-code holds what the
# job set (gcode_test), repeats byte for byte, and comes from the stub
# under swap_test. Jobs the runner must refuse are cam_job_failure_test
# targets below (spec T3).

freecad_step(
    name = "plate",
    script = "plate_part.py",
)

freecad_step(
    name = "holed_plate",
    script = "holed_plate_part.py",
)

freecad_step(
    name = "two_parts",
    script = "two_parts.py",
)

freecad_step(
    name = "no_solid",
    script = "no_solid.py",
)

tool_library(
    name = "tools",
    src = "tools.json",
)

[
    machine(
        name = post + "_router",
        envelope = [
            "400",
            "300",
            "75",
        ],
        max_feed = "5000",
        max_spindle = "24000",
        post = post,
    )
    for post in [
        "grbl",
        "linuxcnc",
    ]
]

[
    cam_job(
        name = "plate_" + post,
        machine = ":%s_router" % post,
        ops = "pocket_ops.py",
        part = ":plate",
        stock = {
            "x": "2",
            "y": "2",
            "z_top": "1",
        },
        tools = ":tools",
    )
    for post in [
        "grbl",
        "linuxcnc",
    ]
]

# A dressup on a Profile: the job takes it, with its operation's tool.
cam_job(
    name = "plate_tagged",
    machine = ":linuxcnc_router",
    ops = "tagged_ops.py",
    part = ":plate",
    tools = ":tools",
)

build_test(
    name = "tagged_test",
    size = "small",
    targets = [":plate_tagged"],
)

go_test(
    name = "gcode_test",
    size = "small",
    srcs = ["gcode_test.go"],
    args = [
        "$(rootpath :plate_grbl)",
        "$(rootpath :plate_linuxcnc)",
    ],
    data = [
        ":plate_grbl",
        ":plate_linuxcnc",
    ],
    pure = "on",
)

[
    determinism_test(
        name = "plate_%s_determinism_test" % post,
        size = "small",
        target = ":plate_" + post,
    )
    for post in [
        "grbl",
        "linuxcnc",
    ]
]

swap_test(
    name = "swap_test",
    size = "small",
    targets = [
        ":plate_grbl",
        ":plate_linuxcnc",
    ],
)

# One line per job the runner must refuse: name, part, ops, and the
# message.
[
    cam_job_failure_test(
        name = name + "_test",
        size = "small",
        checker = "//cam/private/smoke/exitcheck",
        machine = ":grbl_router",
        message = message,
        ops = ops,
        part = part,
        tools = ":tools",
    )
    for name, part, ops, message in [
        ("adaptive", ":plate", "adaptive_ops.py", "Adaptive clearing is not deterministic"),
        ("dressed_adaptive", ":plate", "dressed_adaptive_ops.py", "Adaptive clearing is not deterministic"),
        ("too_fast", ":plate", "fast_ops.py", "horizontal feed 9000 mm/min is above the machine's 5000"),
        ("too_fast_plunge", ":plate", "fast_vfeed_ops.py", "vertical feed 6000 mm/min is above the machine's 5000"),
        ("too_fast_spindle", ":plate", "fast_spindle_ops.py", "spindle 30000 rpm is above the machine's 24000"),
        ("no_feed", ":plate", "no_feed_ops.py", "no horizontal feed; set it, with units"),
        ("no_spindle", ":plate", "no_spindle_ops.py", "no spindle speed"),
        ("foreign_tool", ":plate", "foreign_tool_ops.py", "uses a tool that is not in the tool library"),
        ("all_inactive", ":plate", "inactive_ops.py", "every operation is inactive"),
        ("raises", ":plate", "raises_ops.py", "the operations script raised ValueError: no such face"),
        ("no_solid", ":no_solid", "pocket_ops.py", "has 0 solids; a job machines one"),
        ("no_function", ":plate", "no_function_ops.py", "defines no operations(job, model, tools)"),
        ("no_operations", ":plate", "empty_ops.py", "the operations script added no operations"),
        ("two_solids", ":two_parts", "pocket_ops.py", "has 2 solids; a job machines one"),
    ]
]

# Stock values the rule refuses at analysis time.
[
    [
        cam_job(
            name = name,
            machine = ":grbl_router",
            ops = "pocket_ops.py",
            part = ":plate",
            stock = stock,
            tags = ["manual"],
            tools = ":tools",
        ),
        fails_test(
            name = name + "_test",
            size = "small",
            message = message,
            target_under_test = ":" + name,
        ),
    ]
    for name, stock, message in [
        (
            "stock_unknown_key",
            {"z": "1"},
            "stock key \"z\": want x, y, z_top, z_bottom",
        ),
        (
            "stock_negative",
            {"x": "-1"},
            "stock x \"-1\": want a number of mm, 0 or more",
        ),
        (
            "stock_word",
            {"y": "lots"},
            "stock y \"lots\": want a number of mm, 0 or more",
        ),
    ]
]

# gcode_check_test (issue #10): the plate jobs pass against their own
# machines; each known-bad (spec T3) checks the same G-code against a
# stricter machine, a library without its tool, or a fixture, and must find
# that one kind of violation. "feed" is the M5 exit test.
[
    gcode_check_test(
        name = "plate_%s_gcode_test" % post,
        size = "small",
        job = ":plate_" + post,
    )
    for post in [
        "grbl",
        "linuxcnc",
    ]
]

gcode_check_test(
    name = "plate_tagged_gcode_test",
    size = "small",
    job = ":plate_tagged",
)

[
    machine(
        name = name,
        envelope = envelope,
        max_feed = feed,
        max_spindle = spindle,
        post = "linuxcnc",
    )
    for name, envelope, feed, spindle in [
        (
            "slow_feed_router",
            [
                "400",
                "300",
                "75",
            ],
            "500",
            "24000",
        ),
        (
            "slow_spindle_router",
            [
                "400",
                "300",
                "75",
            ],
            "5000",
            "10000",
        ),
        (
            "tiny_router",
            [
                "30",
                "300",
                "75",
            ],
            "5000",
            "24000",
        ),
    ]
]

tool_library(
    name = "no_t1_tools",
    src = "no_t1_tools.json",
)

[
    gcode_check_test(
        name = name + "_gcode_test",
        size = "small",
        expect = expect,
        gcode = gcode,
        job = ":plate_linuxcnc",
        machine = machine_,
        tools = tools_,
    )
    for name, expect, machine_, tools_, gcode in [
        ("feed_above_limit", "feed", ":slow_feed_router", None, None),
        ("spindle_above_limit", "spindle", ":slow_spindle_router", None, None),
        ("outside_envelope", "envelope", ":tiny_router", None, None),
        ("unknown_tool", "tool", None, ":no_t1_tools", None),
        ("rapid_into_stock", "rapid", None, None, "rapid_into_stock.ngc"),
        ("too_deep", "depth", None, None, "too_deep.ngc"),
        ("cut_without_feed", "feed", None, None, "no_feed.ngc"),
        ("unsupported_plane", "unsupported", None, None, "unsupported.ngc"),
    ]
]

# FreeCAD's Helix leaves a small hole with a rapid to its center at full
# depth, through the bore it has just cut: gcode_check_test accepts it
# (issue #31).
cam_job(
    name = "helix_grbl",
    machine = ":grbl_router",
    ops = "helix_ops.py",
    part = ":holed_plate",
    stock = {
        "x": "2",
        "y": "2",
    },
    tools = ":tools",
)

gcode_check_test(
    name = "helix_gcode_test",
    size = "small",
    job = ":helix_grbl",
)

determinism_test(
    name = "helix_determinism_test",
    size = "small",
    target = ":helix_grbl",
)

# The toolpath pictures and report (issue #35) of three jobs: a pocket and
# profile, holding tags, and a helix.
[
    (
        gcode_render(
            name = job + "_toolpath",
            job = ":" + job,
        ),
        determinism_test(
            name = job + "_toolpath_determinism_test",
            size = "small",
            target = ":" + job + "_toolpath",
        ),
    )
    for job in [
        "plate_linuxcnc",
        "plate_tagged",
        "helix_grbl",
    ]
]
