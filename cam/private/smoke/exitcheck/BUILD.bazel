load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "exitcheck_lib",
    srcs = ["main.go"],
    importpath = "github.com/filmil/bazel_rules_cam/cam/private/smoke/exitcheck",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "exitcheck",
    embed = [":exitcheck_lib"],
    pure = "on",
    visibility = ["//cam/private/smoke:__pkg__"],
)

go_test(
    name = "exitcheck_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":exitcheck_lib"],
    pure = "on",
)
